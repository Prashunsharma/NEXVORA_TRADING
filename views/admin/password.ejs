<%- include("partials/head") %>
<%- include("partials/nav") %>
<main class="admin-wrap">
  <h1>Change password</h1>
  <form class="admin-card admin-form" method="post" action="/admin/password">
    <% if (error) { %><p class="form-error" role="alert"><%= error %></p><% } %>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Current password
      <input type="password" name="current_password" required autocomplete="current-password">
    </label>
    <label>New password (minimum 10 characters)
      <input type="password" name="new_password" required minlength="10" autocomplete="new-password">
    </label>
    <label>Confirm new password
      <input type="password" name="confirm_password" required minlength="10" autocomplete="new-password">
    </label>
    <div class="form-actions">
      <button class="admin-btn primary" type="submit">Change password</button>
      <a class="admin-btn" href="/admin">Cancel</a>
    </div>
  </form>
</main>
<%- include("partials/foot") %>
